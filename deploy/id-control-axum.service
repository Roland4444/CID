[Unit]
Description=ID-Control Rust Axum backend (Synology watcher)
After=network-online.target postgresql.service mnt-synology-id.mount
Wants=network-online.target

[Service]
Type=simple
User=idcontrol
Group=idcontrol
WorkingDirectory=/opt/id-control-axum
EnvironmentFile=/etc/id-control-axum.env
ExecStart=/opt/id-control-axum/target/release/id-control-axum
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/id-control
ReadOnlyPaths=/mnt/synology/id
UMask=0077
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
