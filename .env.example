# PostgreSQL installed on the same Ubuntu server as this application.
# Password in a URL must be URL-encoded when it contains special characters.
DATABASE_URL=postgresql://idcontrol:CHANGE_DB_PASSWORD@127.0.0.1:5432/idcontrol

# Axum binds to localhost; expose it on an internal network via Nginx HTTPS.
LISTEN=127.0.0.1:8090
APP_USER=admin
APP_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_LONG_PASSWORD

# DSM HTTPS / Synology File Station API (NOT SMB/WebDAV)
SYNOLOGY_URL=https://nas.example.local:5001
SYNOLOGY_USERNAME=id_reader
SYNOLOGY_PASSWORD=CHANGE_NAS_PASSWORD
# File Station paths begin with the shared folder name, not /volume1/.
# Affects ONLY this subfolder. Example: /resdata/Исполнительная документация
SYNOLOGY_ROOT=/resdata/Исполнительная документация
SYNOLOGY_VERIFY_TLS=true
# Optional: a PEM certificate of your own CA for a NAS with private PKI
# SYNOLOGY_CA_CERT=/etc/id-control-axum/synology-ca.pem

# Local archive/temporary/OCR files, never written to Synology
DATA_ROOT=/var/lib/id-control
POLL_INTERVAL=45
STABLE_SECONDS=15
MAX_FILE_MB=100
OCR_MAX_PAGES=20
