# PostgreSQL is required; do not use SQLite URLs from the original Python MVP.
DATABASE_URL=postgres://idcontrol:REPLACE_PASSWORD@127.0.0.1:5432/idcontrol
LISTEN=127.0.0.1:8090
WATCH_ROOT=/mnt/synology/id
DATA_ROOT=/var/lib/id-control
APP_USER=admin
APP_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Require the Synology directory to be a mounted filesystem
REQUIRE_MOUNT=true
POLL_INTERVAL=45
STABLE_SECONDS=15
MAX_FILE_MB=100
OCR_MAX_PAGES=20
# Нормативные правила настраиваются и утверждаются в веб-интерфейсе /norms.
